# GEMINI_API_KEY: Optional for auxiliary Gemini phishing context review (server-side only).
# Get key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_SAFE_BROWSING_API_KEY: Optional Google Safe Browsing Lookup API v4 key.
# Get key from Google Cloud Console -> Safe Browsing API.
GOOGLE_SAFE_BROWSING_API_KEY=""

# VIRUSTOTAL_API_KEY: Optional VirusTotal v3 API key (x-apikey header).
# Get free API key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=""

# URLHAUS_AUTH_KEY: Optional abuse.ch URLhaus Auth-Key header (if required by your abuse.ch account).
# Register free at https://auth.abuse.ch/
URLHAUS_AUTH_KEY=""

# PHISHTANK_APP_KEY: Optional PhishTank API application key.
# Register at https://phishtank.org/api_info.php
PHISHTANK_APP_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
